<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>LCOS</vendor>
  <vendor_url>https://lunduke.com</vendor_url>
  <icon_name>system-software-update</icon_name>

  <!-- pkexec matches exec.path plus exec.argv1. A path-only action would
       also match simulate and show the install prompt for a check. -->
  <action id="org.lunduke.lcos-updates.check">
    <description>Check for software updates</description>
    <message>Authentication is required to check for software updates</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/lcos-updates-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">simulate</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

  <action id="org.lunduke.lcos-updates.pkexec">
    <description>Install software updates</description>
    <message>Authentication is required to install software updates</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/lcos-updates-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">upgrade</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
